# Copia este ficheiro para .env e preenche com os dados da tua loja Shopify.
#
# Onde encontrar:
#   Shopify Admin > Definições > Apps e canais de vendas > Programar apps
#   (ou canal "Headless") > Storefront API > Access token
#
# O domínio é o da loja, do tipo: uffa-store.myshopify.com

VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
