# Copia este ficheiro para .env e preenche com os dados da tua loja Shopify.
#
# Onde encontrar:
#   Shopify Admin > Definições > Apps e canais de vendas > Headless
#   > frentes de loja online > Storefront API > Token de acesso público
#
# O domínio é o da loja, do tipo: uffa-store.myshopify.com
# O token é o "Token de acesso público" (NUNCA o token privado).

VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# --- E-mail automático após pagamento (webhook orders/paid) ---
# Signing secret do webhook: Shopify Admin > Definições > Notificações > Webhooks
SHOPIFY_WEBHOOK_SECRET=
# Chave da API Resend (https://resend.com/api-keys)
RESEND_API_KEY=
# Remetente verificado no Resend. Só é preciso verificar o domínio uffastore.pt;
# o endereço pode ser atendimento@uffastore.pt (a caixa que já existe).
RESEND_FROM=UFFA Store <atendimento@uffastore.pt>
# Opcional: se definido, o endpoint só aceita webhooks desta loja.
SHOPIFY_SHOP_DOMAIN=uffastore.myshopify.com

# --- Registo de envio e link mágico de rastreio ---
# URL pública usada nos links enviados por e-mail (sem barra final).
PUBLIC_SITE_URL=https://www.uffastore.pt
# Segredo (mín. 16 caracteres) para assinar os links de rastreio.
ORDER_PORTAL_SECRET=
# Segredo (mín. 16 caracteres) exigido pela página interna /expedicao.
TRACKING_ADMIN_TOKEN=
# Opcional: validade dos links em dias (1 a 30; por omissão 14).
TRACKING_LINK_TTL_DAYS=14

# --- Pesquisa de satisfação 8 dias após a compra ---
# Admin API da Shopify (só no servidor; scopes read_orders e write_orders).
SHOPIFY_ADMIN_STORE_DOMAIN=uffastore.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=
# Opcional: versão da Admin API (por omissão 2026-07).
SHOPIFY_ADMIN_API_VERSION=2026-07
# Segredo exigido pelo Vercel Cron e pelos pedidos manuais a /api/cron/nps.
# Mínimo de 16 caracteres; a Vercel envia-o automaticamente no header.
CRON_SECRET=
# Segredo dos links da pesquisa. Se vazio, usa ORDER_PORTAL_SECRET.
NPS_SECRET=
# Opcional: validade do link da pesquisa em dias (1 a 60; por omissão 30).
NPS_LINK_TTL_DAYS=30
# Envio real só com "true". Sem isto, o cron responde nps_disabled.
NPS_ENABLED=false
