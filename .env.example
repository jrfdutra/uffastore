# Copia este ficheiro para .env e preenche com os dados da tua loja Shopify.
#
# Onde encontrar:
#   Shopify Admin > Definições > Apps e canais de vendas > Headless
#   > frentes de loja online > Storefront API > Token de acesso público
#
# O domínio é o da loja, do tipo: uffa-store.myshopify.com
# O token é o "Token de acesso público" (NUNCA o token privado).

VITE_SHOPIFY_STORE_DOMAIN=
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
